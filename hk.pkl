amends ".hk/org.pkl"

// The copy script writes snippets and syntax from the third_party submodule.
exclude = super.exclude + List("**/snippets/**", "**/syntax/**", "**/third_party/**")

steps {
  ["typescript"] {
    glob = List("package.json", "tsconfig*.json", "src/**/*.ts", "tsup.config.ts")
    check = "pnpm run typecheck"
    depends = "oxlint"
  }
  // .vscode holds JSON with comments.
  ["jq"] { exclude = super.exclude + List(".vscode/**") }
}
