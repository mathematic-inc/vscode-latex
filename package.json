{
  "name": "vscode-latex",
  "displayName": "LaTeX",
  "version": "2.0.2",
  "description": "LaTeX language support for Visual Studio Code.",
  "categories": [
    "Programming Languages",
    "Formatters",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "latex",
    "tex",
    "bibtex",
    "syntax highlighting",
    "formatter",
    "linter",
    "snippets"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mathematic-inc/vscode-latex.git"
  },
  "license": "Apache-2.0",
  "author": "Mathematic Inc",
  "publisher": "mathematic",
  "main": "./dist/extension.js",
  "scripts": {
    "prebuild": "pnpm run copy",
    "build": "tsup",
    "check": "pnpm run typecheck && oxlint --deny-warnings . && oxfmt --check src tsup.config.ts package.json tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "copy": "rm -rf snippets syntax && mkdir -p snippets && cp third_party/LaTeX-Workshop/data/latex-snippet.json snippets/latex.json && cp -R third_party/LaTeX-Workshop/syntax . && node -e 'const fs=require(\"node:fs\"),p=\"syntax/LaTeX.tmLanguage.json\";fs.writeFileSync(p,fs.readFileSync(p,\"utf8\").replaceAll(\"\\\"$self\\\"\",\"\\\"$base\\\"\"))'",
    "fix": "oxlint --fix --deny-warnings . && oxfmt --write src tsup.config.ts package.json tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "format": "oxfmt --write src tsup.config.ts package.json tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "lint": "oxlint --deny-warnings .",
    "package": "pnpm test && pnpm run copy && tsup --minify",
    "prepare": "if [ -z \"$CI\" ] && command -v hk >/dev/null 2>&1; then hk install; fi",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "pnpm run package",
    "watch": "tsup --watch"
  },
  "contributes": {
    "capabilities": {
      "documentFormattingProvider": "true",
      "untrustedWorkspaces": {
        "supported": true,
        "description": "The extension and its dependencies don't parse forever."
      }
    },
    "configuration": {
      "title": "LaTeX",
      "properties": {
        "latex.linter.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enables the linter."
        },
        "latex.linter.delay": {
          "type": "number",
          "default": 1000,
          "markdownDescription": "Duration (in ms) to delay linting during contiguous typing."
        },
        "latex.linter.timeout": {
          "type": "number",
          "default": 10000,
          "markdownDescription": "Amount of time (in ms) to wait for the linter to finish."
        },
        "latex.linter.config": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute/relative path to the configuration file for the linter. Default behavior is to search the directory (or parents) of the file (or the workspace) till a configuration is found. See the extension's description."
        },
        "latex.linter.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute/relative path to the linter executable. Default behavior is to find the system's executable if it exists."
        },
        "latex.formatter.program": {
          "type": "string",
          "enum": [
            "latexindent",
            "tex-fmt"
          ],
          "enumDescriptions": [
            "Format with latexindent.",
            "Format with tex-fmt."
          ],
          "default": "latexindent",
          "markdownDescription": "Program used to format LaTeX documents."
        },
        "latex.formatter.columnLimit": {
          "type": "number",
          "minimum": 0,
          "default": 80,
          "markdownDescription": "Column limit for a given line.\n\nA column limit of `0` means that there is no column limit. This is overridden if a configuration file is found in some parent of the file."
        },
        "latex.formatter.config": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute/relative path to the selected formatter's YAML or TOML configuration file. Default behavior is to search the directory and its parents. See the extension's description."
        },
        "latex.formatter.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute/relative path to the selected formatter executable. Default behavior is to find the system's executable if it exists."
        },
        "latex.formatter.timeout": {
          "type": "number",
          "default": 10000,
          "markdownDescription": "Amount of time (in ms) to wait for the formatter to finish."
        }
      }
    },
    "grammars": [
      {
        "language": "tex",
        "scopeName": "text.tex",
        "path": "./syntax/TeX.tmLanguage.json",
        "unbalancedBracketScopes": [
          "keyword.control.ifnextchar.tex",
          "punctuation.math.operator.tex"
        ]
      },
      {
        "language": "latex",
        "scopeName": "text.tex.latex",
        "path": "./syntax/LaTeX.tmLanguage.json",
        "unbalancedBracketScopes": [
          "keyword.control.ifnextchar.tex",
          "punctuation.math.operator.tex"
        ],
        "embeddedLanguages": {
          "source.asymptote": "asymptote",
          "source.cpp": "cpp_embedded_latex",
          "source.css": "css",
          "source.dot": "dot",
          "source.gnuplot": "gnuplot",
          "text.html": "html",
          "source.java": "java",
          "source.js": "javascript",
          "source.julia": "julia",
          "source.lua": "lua",
          "source.python": "python",
          "source.ruby": "ruby",
          "source.scala": "scala",
          "source.ts": "typescript",
          "text.xml": "xml",
          "source.yaml": "yaml",
